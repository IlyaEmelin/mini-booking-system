# Локальная разработка mini-booking-system.
# Шаблон для файла .env: скопируйте его и подставьте локальные значения.
# Состав переменных описан в spec.md, раздел «Переменные окружения».

# PostgreSQL, локальный инстанс: host=localhost, port=5432, database=mini-booking-system_dev.
# Логин и пароль подставляются локально и в репозиторий не попадают.
DATABASE_URL="postgresql://<login>:<password>@localhost:5432/mini-booking-system_dev"

# Срок жизни сессии в секундах: 7 дней. Значение — положительное целое число.
SESSION_TTL_SECONDS="604800"

# Учётные данные начального пользователя с ролью super_admin (prisma/seed.ts).
# SEED_SUPER_ADMIN_PASSWORD — заглушка, а не рабочий пароль: seed отклоняет это
# значение (CR-27). Рабочие значения задаются локально в .env и за пределами
# разработки не используются.
SEED_SUPER_ADMIN_EMAIL="superadmin@mini-booking.me"
SEED_SUPER_ADMIN_PASSWORD="<change-me-for-local-development>"
